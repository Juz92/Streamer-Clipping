{
  "name": "ltx-automation",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ltx-automation",
      "version": "1.0.0",
      "workspaces": [
        "packages/*"
      ],
      "devDependencies": {}
    },
    "node_modules/@ltx/pipeline": {
      "resolved": "packages/pipeline",
      "link": true
    },
    "node_modules/@ltx/remotion": {
      "resolved": "packages/remotion",
      "link": true
    },
    "node_modules/@ltx/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/pipeline": {
      "name": "@ltx/pipeline",
      "version": "1.0.0",
      "dependencies": {
        "@ltx/shared": "*"
      }
    },
    "packages/remotion": {
      "name": "@ltx/remotion",
      "version": "1.0.0",
      "dependencies": {
        "@ltx/shared": "*"
      }
    },
    "packages/shared": {
      "name": "@ltx/shared",
      "version": "1.0.0"
    }
  }
}
